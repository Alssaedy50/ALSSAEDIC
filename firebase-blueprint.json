{
  "entities": {
    "Clinic": {
      "title": "Clinic",
      "description": "Stores clinic identity, branding, and operational preferences for an authenticated clinic account.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clinicAr": {
          "type": "string",
          "description": "Arabic name of the dental clinic.",
          "minLength": 1,
          "maxLength": 160
        },
        "doctorAr": {
          "type": "string",
          "description": "Arabic name of the doctor.",
          "minLength": 1,
          "maxLength": 160
        },
        "specialtyAr": {
          "type": "string",
          "description": "Arabic specialty description.",
          "minLength": 1,
          "maxLength": 200
        },
        "clinicEn": {
          "type": "string",
          "description": "English name of the dental clinic.",
          "minLength": 1,
          "maxLength": 160
        },
        "doctorEn": {
          "type": "string",
          "description": "English name of the doctor.",
          "minLength": 1,
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "description": "Physical address of the clinic.",
          "minLength": 1,
          "maxLength": 250
        },
        "phones": {
          "type": "string",
          "description": "Contact phone numbers of the clinic.",
          "minLength": 1,
          "maxLength": 200
        },
        "defaultCurrency": {
          "type": "string",
          "description": "Default currency label.",
          "minLength": 1,
          "maxLength": 40
        },
        "primaryColor": {
          "type": "string",
          "description": "Primary brand hex color.",
          "minLength": 4,
          "maxLength": 20
        },
        "watermarkOpacity": {
          "type": "number",
          "description": "Receipt watermark opacity percentage (0-30)."
        },
        "autoInventory": {
          "type": "boolean",
          "description": "Whether issuing a receipt automatically deducts linked inventory."
        },
        "showQrCode": {
          "type": "boolean",
          "description": "Whether to display the verification QR code on receipts."
        },
        "customLogoDataUrl": {
          "type": "string",
          "description": "Data URL for clinic logo.",
          "maxLength": 350000
        },
        "permanentAccountantSig": {
          "type": "string",
          "description": "Data URL for permanent doctor/accountant signature.",
          "maxLength": 250000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "clinicAr",
        "doctorAr",
        "specialtyAr",
        "clinicEn",
        "doctorEn",
        "address",
        "phones",
        "defaultCurrency",
        "primaryColor",
        "watermarkOpacity",
        "autoInventory",
        "showQrCode",
        "customLogoDataUrl",
        "permanentAccountantSig",
        "createdAt",
        "updatedAt"
      ]
    },
    "DentalService": {
      "title": "DentalService",
      "description": "A dental procedure/service item with a default price, category, and keywords.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Service name in Arabic.",
          "minLength": 1,
          "maxLength": 140
        },
        "price": {
          "type": "number",
          "description": "Default price of the dental service."
        },
        "category": {
          "type": "string",
          "description": "Service category in Arabic.",
          "minLength": 1,
          "maxLength": 100
        },
        "keywords": {
          "type": "array",
          "description": "Bounded list of search/AI keywords for the service (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "name", "price", "category", "keywords", "createdAt", "updatedAt"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Official patient financial receipt voucher.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "receiptNo": {
          "type": "number",
          "description": "Sequential receipt number."
        },
        "date": {
          "type": "string",
          "description": "Receipt date string (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 30
        },
        "patientName": {
          "type": "string",
          "description": "Full name of the patient.",
          "minLength": 1,
          "maxLength": 160
        },
        "patientPhone": {
          "type": "string",
          "description": "Patient phone number.",
          "maxLength": 50
        },
        "services": {
          "type": "array",
          "description": "Bounded list of selected treatment service names (max 25)."
        },
        "toothFDI": {
          "type": "string",
          "description": "Comma-separated FDI tooth numbers.",
          "maxLength": 200
        },
        "totalAmount": {
          "type": "number",
          "description": "Total treatment amount."
        },
        "paidAmount": {
          "type": "number",
          "description": "Paid amount received."
        },
        "remainingAmount": {
          "type": "number",
          "description": "Remaining balance on the patient."
        },
        "currency": {
          "type": "string",
          "description": "Currency name.",
          "minLength": 1,
          "maxLength": 40
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method description.",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "description": "Additional receipt notes.",
          "maxLength": 500
        },
        "amountWords": {
          "type": "string",
          "description": "Arabic Tafqeet words for the paid amount.",
          "minLength": 1,
          "maxLength": 300
        },
        "accountantSig": {
          "type": "string",
          "description": "Data URL for doctor/accountant signature.",
          "maxLength": 250000
        },
        "receiverSig": {
          "type": "string",
          "description": "Data URL for patient/receiver signature.",
          "maxLength": 250000
        },
        "paperFormat": {
          "type": "string",
          "description": "Receipt paper format.",
          "enum": ["a5", "thermal80"],
          "minLength": 2,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "receiptNo",
        "date",
        "patientName",
        "patientPhone",
        "services",
        "toothFDI",
        "totalAmount",
        "paidAmount",
        "remainingAmount",
        "currency",
        "paymentMethod",
        "notes",
        "amountWords",
        "accountantSig",
        "receiverSig",
        "paperFormat",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Dental clinic consumable or medical supply item.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Item name.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Item category or specification.",
          "maxLength": 160
        },
        "qty": {
          "type": "number",
          "description": "Current quantity in stock."
        },
        "minQty": {
          "type": "number",
          "description": "Minimum alert threshold quantity."
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement.",
          "minLength": 1,
          "maxLength": 50
        },
        "unitPrice": {
          "type": "number",
          "description": "Cost per unit."
        },
        "totalCost": {
          "type": "number",
          "description": "Total inventory value for this item."
        },
        "linkedService": {
          "type": "string",
          "description": "Linked dental service for automatic deduction.",
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "qty",
        "minQty",
        "unit",
        "unitPrice",
        "totalCost",
        "linkedService",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operational or procurement expense record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Expense title or description.",
          "minLength": 1,
          "maxLength": 200
        },
        "amount": {
          "type": "number",
          "description": "Expense amount."
        },
        "category": {
          "type": "string",
          "description": "Expense category.",
          "minLength": 1,
          "maxLength": 100
        },
        "currency": {
          "type": "string",
          "description": "Expense currency.",
          "minLength": 1,
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "description": "Expense date (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "amount",
        "category",
        "currency",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClinicWorkspace": {
      "title": "ClinicWorkspace",
      "description": "Unified multi-device clinic workspace keyed by clinicId with SHA-256 password hash.",
      "type": "object",
      "properties": {
        "clinicId": {
          "type": "string",
          "description": "Normalized clinic identifier.",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "passwordHash": {
          "type": "string",
          "description": "SHA-256 hex digest of the workspace password.",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "settings": {
          "type": "object",
          "description": "Clinic settings map including identity, appearance, features, and services."
        },
        "receipts": {
          "type": "array",
          "description": "Bounded list of clinic receipt records (max 500)."
        },
        "inventory": {
          "type": "array",
          "description": "Bounded list of clinic inventory items (max 500)."
        },
        "expenses": {
          "type": "array",
          "description": "Bounded list of clinic expense records (max 500)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "clinicId",
        "passwordHash",
        "settings",
        "receipts",
        "inventory",
        "expenses",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/clinics/{clinicId}": {
      "schema": { "$ref": "#/entities/Clinic" },
      "description": "Clinic profile and settings keyed by owner UID."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/DentalService" },
      "description": "Dental services catalog owned by a clinic."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Patient financial receipts owned by a clinic."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Medical inventory items owned by a clinic."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Clinic expenses owned by a clinic."
    },
    "/clinic_workspaces/{clinicId}": {
      "schema": { "$ref": "#/entities/ClinicWorkspace" },
      "description": "Direct multi-phone clinic workspace synced by clinicId and SHA-256 password hash."
    }
  }
}

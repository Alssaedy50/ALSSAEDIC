{
  "entities": {
    "Clinic": {
      "title": "Clinic",
      "description": "Stores clinic identity, branding, and operational preferences for an authenticated clinic account.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerEmail": {
          "type": "string",
          "description": "Authenticated email address of the clinic owner.",
          "maxLength": 160
        },
        "clinicAr": {
          "type": "string",
          "description": "Arabic name of the dental clinic.",
          "minLength": 1,
          "maxLength": 160
        },
        "doctorAr": {
          "type": "string",
          "description": "Arabic name of the doctor.",
          "minLength": 1,
          "maxLength": 160
        },
        "specialtyAr": {
          "type": "string",
          "description": "Arabic specialty description.",
          "minLength": 1,
          "maxLength": 200
        },
        "clinicEn": {
          "type": "string",
          "description": "English name of the dental clinic.",
          "minLength": 1,
          "maxLength": 160
        },
        "doctorEn": {
          "type": "string",
          "description": "English name of the doctor.",
          "minLength": 1,
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "description": "Physical address of the clinic.",
          "minLength": 1,
          "maxLength": 250
        },
        "phones": {
          "type": "string",
          "description": "Contact phone numbers of the clinic.",
          "minLength": 1,
          "maxLength": 200
        },
        "defaultCurrency": {
          "type": "string",
          "description": "Default currency label.",
          "minLength": 1,
          "maxLength": 40
        },
        "primaryColor": {
          "type": "string",
          "description": "Primary brand hex color.",
          "minLength": 4,
          "maxLength": 20
        },
        "watermarkOpacity": {
          "type": "number",
          "description": "Receipt watermark opacity percentage (0-30)."
        },
        "autoInventory": {
          "type": "boolean",
          "description": "Whether issuing a receipt automatically deducts linked inventory."
        },
        "showQrCode": {
          "type": "boolean",
          "description": "Whether to display the verification QR code on receipts."
        },
        "customLogoDataUrl": {
          "type": "string",
          "description": "Data URL for clinic logo.",
          "maxLength": 350000
        },
        "permanentAccountantSig": {
          "type": "string",
          "description": "Data URL for permanent doctor/accountant signature.",
          "maxLength": 250000
        },
        "telegramBackup": {
          "type": "object",
          "description": "Telegram backup bot token and channel settings."
        },
        "subscription": {
          "type": "object",
          "description": "Subscription tier and AI feature authorization status managed by platform developer."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "clinicAr",
        "doctorAr",
        "specialtyAr",
        "clinicEn",
        "doctorEn",
        "address",
        "phones",
        "defaultCurrency",
        "primaryColor",
        "watermarkOpacity",
        "autoInventory",
        "showQrCode",
        "customLogoDataUrl",
        "permanentAccountantSig",
        "createdAt",
        "updatedAt"
      ]
    },
    "DentalService": {
      "title": "DentalService",
      "description": "A dental procedure/service item with a default price, category, and keywords.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Service name in Arabic.",
          "minLength": 1,
          "maxLength": 140
        },
        "price": {
          "type": "number",
          "description": "Default price of the dental service."
        },
        "category": {
          "type": "string",
          "description": "Service category in Arabic.",
          "minLength": 1,
          "maxLength": 100
        },
        "keywords": {
          "type": "array",
          "description": "Bounded list of search/AI keywords for the service (max 20)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["ownerId", "name", "price", "category", "keywords", "createdAt", "updatedAt"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Official patient financial receipt voucher.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "receiptNo": {
          "type": "number",
          "description": "Sequential receipt number."
        },
        "date": {
          "type": "string",
          "description": "Receipt date string (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 30
        },
        "patientName": {
          "type": "string",
          "description": "Full name of the patient.",
          "minLength": 1,
          "maxLength": 160
        },
        "patientPhone": {
          "type": "string",
          "description": "Patient phone number.",
          "maxLength": 50
        },
        "services": {
          "type": "array",
          "description": "Bounded list of selected treatment service names (max 25)."
        },
        "toothFDI": {
          "type": "string",
          "description": "Comma-separated FDI tooth numbers.",
          "maxLength": 200
        },
        "totalAmount": {
          "type": "number",
          "description": "Total treatment amount."
        },
        "paidAmount": {
          "type": "number",
          "description": "Paid amount received."
        },
        "remainingAmount": {
          "type": "number",
          "description": "Remaining balance on the patient."
        },
        "currency": {
          "type": "string",
          "description": "Currency name.",
          "minLength": 1,
          "maxLength": 40
        },
        "paymentMethod": {
          "type": "string",
          "description": "Payment method description.",
          "minLength": 1,
          "maxLength": 80
        },
        "notes": {
          "type": "string",
          "description": "Additional receipt notes.",
          "maxLength": 500
        },
        "amountWords": {
          "type": "string",
          "description": "Arabic Tafqeet words for the paid amount.",
          "minLength": 1,
          "maxLength": 300
        },
        "accountantSig": {
          "type": "string",
          "description": "Data URL for doctor/accountant signature.",
          "maxLength": 250000
        },
        "receiverSig": {
          "type": "string",
          "description": "Data URL for patient/receiver signature.",
          "maxLength": 250000
        },
        "paperFormat": {
          "type": "string",
          "description": "Receipt paper format.",
          "enum": ["a5", "thermal80"],
          "minLength": 2,
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "receiptNo",
        "date",
        "patientName",
        "patientPhone",
        "services",
        "toothFDI",
        "totalAmount",
        "paidAmount",
        "remainingAmount",
        "currency",
        "paymentMethod",
        "notes",
        "amountWords",
        "accountantSig",
        "receiverSig",
        "paperFormat",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Dental clinic consumable or medical supply item.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Item name.",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "description": "Item category or specification.",
          "maxLength": 160
        },
        "qty": {
          "type": "number",
          "description": "Current quantity in stock."
        },
        "minQty": {
          "type": "number",
          "description": "Minimum alert threshold quantity."
        },
        "unit": {
          "type": "string",
          "description": "Unit of measurement.",
          "minLength": 1,
          "maxLength": 50
        },
        "unitPrice": {
          "type": "number",
          "description": "Cost per unit."
        },
        "totalCost": {
          "type": "number",
          "description": "Total inventory value for this item."
        },
        "linkedService": {
          "type": "string",
          "description": "Linked dental service for automatic deduction.",
          "maxLength": 140
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "qty",
        "minQty",
        "unit",
        "unitPrice",
        "totalCost",
        "linkedService",
        "createdAt",
        "updatedAt"
      ]
    },
    "Expense": {
      "title": "Expense",
      "description": "Operational or procurement expense record.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "description": "Expense title or description.",
          "minLength": 1,
          "maxLength": 200
        },
        "amount": {
          "type": "number",
          "description": "Expense amount."
        },
        "category": {
          "type": "string",
          "description": "Expense category.",
          "minLength": 1,
          "maxLength": 100
        },
        "currency": {
          "type": "string",
          "description": "Expense currency.",
          "minLength": 1,
          "maxLength": 40
        },
        "date": {
          "type": "string",
          "description": "Expense date (YYYY-MM-DD).",
          "minLength": 1,
          "maxLength": 30
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "title",
        "amount",
        "category",
        "currency",
        "date",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClinicWorkspace": {
      "title": "ClinicWorkspace",
      "description": "Authenticated clinic workspace metadata keyed by clinicId and bound strictly to ownerId (request.auth.uid).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the authenticated clinic owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "clinicId": {
          "type": "string",
          "description": "Normalized clinic identifier.",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "settings": {
          "type": "object",
          "description": "Clinic settings map including identity, appearance, and features."
        },
        "receiptCount": {
          "type": "number",
          "description": "Total number of receipts stored in the receipts collection for this clinic."
        },
        "inventoryCount": {
          "type": "number",
          "description": "Total number of inventory items stored in the inventory collection for this clinic."
        },
        "expenseCount": {
          "type": "number",
          "description": "Total number of expenses stored in the expenses collection for this clinic."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "clinicId",
        "settings",
        "receiptCount",
        "inventoryCount",
        "expenseCount",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Team member record within a clinic workspace with role and granular permissions.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["owner", "doctor", "accountant", "receptionist", "viewer"] },
        "permissions": { "type": "object" },
        "addedBy": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "invited"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "permissions", "addedBy", "status", "joinedAt", "updatedAt"]
    },
    "UserWorkspaceIndex": {
      "title": "UserWorkspaceIndex",
      "description": "Fast lookup index mapping member email to assigned clinic workspace and role.",
      "type": "object",
      "properties": {
        "workspaceId": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["owner", "doctor", "accountant", "receptionist", "viewer"] },
        "permissions": { "type": "object" },
        "addedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceId", "email", "role", "permissions", "addedBy", "updatedAt"]
    },
    "AccountIdentifier": {
      "title": "AccountIdentifier",
      "description": "Index mapping custom user identifiers to their verified account email and UID.",
      "type": "object",
      "properties": {
        "identifier": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["identifier", "email", "uid", "createdAt"]
    }
  },
  "firestore": {
    "/clinics/{clinicId}": {
      "schema": { "$ref": "#/entities/Clinic" },
      "description": "Clinic profile and settings keyed by owner UID."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/DentalService" },
      "description": "Dental services catalog owned by a clinic."
    },
    "/receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/Receipt" },
      "description": "Patient financial receipts owned by a clinic."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Medical inventory items owned by a clinic."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Clinic expenses owned by a clinic."
    },
    "/clinic_workspaces/{clinicId}": {
      "schema": { "$ref": "#/entities/ClinicWorkspace" },
      "description": "Authenticated clinic workspace metadata bound to ownerId."
    },
    "/clinic_workspaces/{clinicId}/members/{memberKey}": {
      "schema": { "$ref": "#/entities/WorkspaceMember" },
      "description": "Team members belonging to a clinic workspace."
    },
    "/user_workspaces/{memberKey}": {
      "schema": { "$ref": "#/entities/UserWorkspaceIndex" },
      "description": "User email mapping to workspace."
    },
    "/account_identifiers/{identifier}": {
      "schema": { "$ref": "#/entities/AccountIdentifier" },
      "description": "Public lookup mapping unique clinic identifiers to the account email."
    }
  }
}
